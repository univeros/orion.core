{
    "name": "orion-search/core",
    "description": "Orion core: query and schema ASTs, engine adapter contracts, deterministic index lifecycle (plan, apply, zero-downtime reindex by outbox replay, signed receipts), framework-free",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "2am.tech",
            "homepage": "https://2am.tech"
        }
    ],
    "keywords": [
        "search",
        "elasticsearch",
        "opensearch",
        "solr",
        "meilisearch",
        "reindex",
        "hybrid-search",
        "vector-search"
    ],
    "require": {
        "php": ">=8.3",
        "ext-sodium": "*",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/uid": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0"
    },
    "require-dev": {
        "orion-search/testing": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "Orion\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Orion\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
